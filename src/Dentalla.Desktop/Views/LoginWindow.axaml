<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Dentalla.Desktop.Views.LoginWindow"
        Title="Dentalla MIS — вход"
        Width="1040" Height="650"
        MinWidth="920" MinHeight="590"
        CanResize="True"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="380,*" Background="{DynamicResource DentallaBackground}">
    <!-- Brand panel -->
    <Border Grid.Column="0" Background="{DynamicResource DentallaSidebar}">
      <Grid RowDefinitions="Auto,*,Auto" Margin="42,42,42,34">
        <Image Grid.Row="0"
               Source="avares://Dentalla.Desktop/Assets/Logo1.png"
               Height="94"
               Stretch="Uniform"
               HorizontalAlignment="Left" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="18">
          <Border Width="54" Height="4" CornerRadius="2"
                  Background="{DynamicResource DentallaAccent}"
                  HorizontalAlignment="Left" />
          <TextBlock Text="Одна система для клинической работы, расписания и управления клиникой."
                     Foreground="White"
                     FontSize="25"
                     FontWeight="SemiBold"
                     LineHeight="34"
                     TextWrapping="Wrap" />
          <TextBlock Text="Выберите рабочую роль и сотрудника. Набор разделов и действий после входа определяется правами этой роли."
                     Foreground="#E8E3DF"
                     FontSize="14"
                     LineHeight="21"
                     TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="5">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="8" Height="8" CornerRadius="4"
                    Background="#6FCF97" VerticalAlignment="Center" />
            <TextBlock Text="Dentalla Server • localhost"
                       Foreground="White" FontSize="12" />
          </StackPanel>
          <TextBlock Text="Серверная рабочая станция"
                     Foreground="#D7D1CD" FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Login surface -->
    <Grid Grid.Column="1" Margin="72,58" RowDefinitions="*,Auto,*">
      <Border Grid.Row="1"
              Background="White"
              BorderBrush="{DynamicResource DentallaLine}"
              BorderThickness="1"
              CornerRadius="18"
              Padding="42,38"
              BoxShadow="0 16 46 0 #18000000"
              MaxWidth="520"
              HorizontalAlignment="Stretch">
        <StackPanel Spacing="24">
          <StackPanel Spacing="7">
            <TextBlock Text="Добро пожаловать"
                       FontSize="30"
                       FontWeight="SemiBold" />
            <TextBlock Text="Вход в информационную систему Денталла"
                       Classes="Muted"
                       FontSize="14" />
          </StackPanel>

          <Border Height="1" Background="{DynamicResource DentallaLine}" />

          <StackPanel Spacing="9">
            <TextBlock Text="Рабочая роль"
                       FontWeight="SemiBold" FontSize="13" />
            <ComboBox ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      MinHeight="48"
                      HorizontalAlignment="Stretch"
                      CornerRadius="10"
                      Padding="12,6">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Margin="2,4" Spacing="2">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Description}"
                               Classes="Muted" FontSize="11" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="9">
            <TextBlock Text="Сотрудник"
                       FontWeight="SemiBold" FontSize="13" />
            <ComboBox ItemsSource="{Binding AvailableEmployees}"
                      SelectedItem="{Binding SelectedEmployee}"
                      MinHeight="48"
                      HorizontalAlignment="Stretch"
                      CornerRadius="10"
                      Padding="12,6">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="38,*" Margin="2,3">
                    <Border Width="32" Height="32" CornerRadius="16"
                            Background="{DynamicResource DentallaAccentSoft}">
                      <TextBlock Text="●"
                                 Foreground="{DynamicResource DentallaAccent}"
                                 FontSize="12"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding Name}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <Border Background="#FAF8EE" CornerRadius="10" Padding="12,10">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
              <TextBlock Text="i"
                         Foreground="{DynamicResource DentallaAccent}"
                         FontWeight="Bold"
                         VerticalAlignment="Top" />
              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock Text="На текущем этапе пароль отключён."
                           FontWeight="SemiBold"
                           FontSize="12" />
                <TextBlock Text="{Binding StatusText}"
                           Classes="Muted"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="2" Content="↻" Classes="Secondary" Padding="9,5" Click="OnReloadClick" ToolTip.Tip="Обновить список сотрудников" />
            </Grid>
          </Border>

          <Button Content="Войти"
                  Classes="Primary"
                  Height="48"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Center"
                  FontSize="14"
                  FontWeight="SemiBold"
                  IsEnabled="{Binding CanContinue}"
                  Click="OnLoginClick" />

          <TextBlock Text="Dentalla MIS • серверная версия"
                     HorizontalAlignment="Center"
                     Classes="Muted"
                     FontSize="11" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
