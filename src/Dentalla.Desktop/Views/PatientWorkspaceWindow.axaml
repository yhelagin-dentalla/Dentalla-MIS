<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Dentalla.Desktop.Views"
        x:Class="Dentalla.Desktop.Views.PatientWorkspaceWindow"
        Title="Карточка пациента"
        Width="1520"
        Height="930"
        MinWidth="1120"
        MinHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource DentallaBackground}">
  <Border Padding="12">
    <local:PatientCardView />
  </Border>
</Window>
