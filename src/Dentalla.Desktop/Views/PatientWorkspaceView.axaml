<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Dentalla.Desktop.Views.PatientWorkspaceView">
  <UserControl.Styles>
    <Style Selector="ListBox.LightSelection ListBoxItem:selected">
      <Setter Property="Background" Value="#E8E8E5" />
      <Setter Property="Foreground" Value="{DynamicResource DentallaText}" />
    </Style>
    <Style Selector="ListBox.LightSelection ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#E8E8E5" />
      <Setter Property="Foreground" Value="{DynamicResource DentallaText}" />
    </Style>
    <Style Selector="ListBox.LightSelection ListBoxItem:selected:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#DEDEDA" />
      <Setter Property="Foreground" Value="{DynamicResource DentallaText}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <Border Grid.Row="0" Classes="Card">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
        <TextBox Grid.Column="0"
                 Text="{Binding SearchText}"
                 Watermark="ФИО или № карты"
                 KeyDown="OnSearchKeyDown" />
        <Button Grid.Column="1"
                Content="Найти"
                Classes="Primary"
                Click="OnSearchClick" />
        <TextBlock Grid.Row="1"
                   Grid.ColumnSpan="2"
                   Text="{Binding StatusText}"
                   Classes="Muted"
                   FontSize="11" />
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="320,*,430" ColumnSpacing="10">
      <Border Grid.Column="0" Classes="Card" Padding="0">
        <Grid RowDefinitions="46,*">
          <Border Padding="14,12"
                  BorderBrush="{DynamicResource DentallaLine}"
                  BorderThickness="0,0,0,1">
            <TextBlock Text="Пациенты" Classes="H2" />
          </Border>

          <ListBox Grid.Row="1"
                   Classes="LightSelection"
                   ItemsSource="{Binding SearchResults}"
                   SelectedItem="{Binding SelectedPatient}"
                   SelectionChanged="OnPatientSelectionChanged">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Spacing="0" Margin="4,1">
                  <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding CardNumber, StringFormat='карта № {0}'}" Classes="Muted" FontSize="11" />
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Classes="Card" Padding="0">
        <Grid RowDefinitions="Auto,Auto,*">
          <StackPanel Margin="16,14,16,12" Spacing="4">
            <TextBlock Text="{Binding PatientHeader}" FontSize="21" FontWeight="SemiBold" />
            <TextBlock Text="{Binding PatientMetaText}" Classes="Muted" />
            <TextBlock Text="{Binding SourceIdsText}" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
            <TextBlock Text="{Binding HistoricalReceiptText}" FontWeight="SemiBold" Margin="0,4,0,0" />
          </StackPanel>

          <Border Grid.Row="1"
                  Background="#FAF8EE"
                  Padding="14,8"
                  BorderBrush="{DynamicResource DentallaLine}"
                  BorderThickness="0,1,0,1">
            <Grid ColumnDefinitions="110,95,*,110,120">
              <TextBlock Text="Дата" Classes="Muted" FontWeight="SemiBold" />
              <TextBlock Grid.Column="1" Text="Время" Classes="Muted" FontWeight="SemiBold" />
              <TextBlock Grid.Column="2" Text="Врач / комментарий" Classes="Muted" FontWeight="SemiBold" />
              <TextBlock Grid.Column="3" Text="Статус" Classes="Muted" FontWeight="SemiBold" />
              <TextBlock Grid.Column="4" Text="Услуги" Classes="Muted" FontWeight="SemiBold" />
            </Grid>
          </Border>

          <ListBox Grid.Row="2"
                   Classes="LightSelection"
                   ItemsSource="{Binding Visits}"
                   SelectedItem="{Binding SelectedVisit}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="110,95,*,110,120" Margin="6,3">
                  <TextBlock Text="{Binding DateText}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding TimeText}" />
                  <StackPanel Grid.Column="2" Spacing="1">
                    <TextBlock Text="{Binding DoctorText}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CommentText}" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Grid.Column="3" Text="{Binding StatusText}" />
                  <TextBlock Grid.Column="4" Text="{Binding ServicesText}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <Border Classes="Card">
            <StackPanel Spacing="10">
              <TextBlock Text="Услуги выбранного посещения" Classes="H2" />
              <ItemsControl ItemsSource="{Binding SelectedVisitServices}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource DentallaLine}" BorderThickness="0,0,0,1" Padding="0,8">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding NameText}" TextWrapping="Wrap" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding MetaText}" Classes="Muted" FontSize="11" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding AmountText}" FontWeight="SemiBold" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Если у записи нет Encounter, выполненные услуги здесь не показываются."
                         Classes="Muted"
                         FontSize="10"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="Card">
            <StackPanel Spacing="8">
              <TextBlock Text="Курсы лечения" Classes="H2" />
              <ItemsControl ItemsSource="{Binding TreatmentCourses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#FAF8EE" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding OwnerStaffName}" Classes="Muted" FontSize="11" />
                        <TextBlock Text="{Binding EncounterCount, StringFormat='Связанных посещений: {0}'}" Classes="Muted" FontSize="11" />
                        <TextBlock Text="{Binding PlannedServiceCount, StringFormat='Плановых услуг: {0}'}" Classes="Muted" FontSize="11" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="Card">
            <StackPanel Spacing="8">
              <TextBlock Text="Исторические поступления" Classes="H2" />
              <ItemsControl ItemsSource="{Binding HistoricalReceipts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                      <StackPanel Spacing="1">
                        <TextBlock Text="{Binding SourceSystem}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CalculationCode}" Classes="Muted" FontSize="10" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Amount}" FontWeight="SemiBold" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Это исторический агрегат фактически полученных средств, а не текущий баланс пациента."
                         Classes="Muted"
                         FontSize="10"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <Border Grid.Row="2" Classes="Card" Padding="12,8">
      <TextBlock Text="Read-only Patient Workspace: данные читаются из нормализованной Dentalla БД. Редактирование пациента будет подключено после перехода Person → Patient."
                 Classes="Muted"
                 FontSize="11"
                 TextWrapping="Wrap" />
    </Border>
  </Grid>
</UserControl>
