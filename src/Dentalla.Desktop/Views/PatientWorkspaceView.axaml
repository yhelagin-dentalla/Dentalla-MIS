<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Dentalla.Desktop.Views"
             x:Class="Dentalla.Desktop.Views.PatientWorkspaceView">
  <UserControl.Styles>
    <Style Selector="ListBox.LightSelection ListBoxItem:selected"><Setter Property="Background" Value="#E8E8E5" /><Setter Property="Foreground" Value="{DynamicResource DentallaText}" /></Style>
    <Style Selector="ListBox.LightSelection ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="#E8E8E5" /><Setter Property="Foreground" Value="{DynamicResource DentallaText}" /></Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,*" RowSpacing="10">
    <Border Classes="Card"><Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6"><TextBox Text="{Binding SearchText}" PlaceholderText="ФИО или № карты" KeyDown="OnSearchKeyDown" /><Button Grid.Column="1" Content="Найти" Classes="Primary" Click="OnSearchClick" /><TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding StatusText}" Classes="Muted" FontSize="11" /></Grid></Border>
    <Grid Grid.Row="1" ColumnDefinitions="300,*" ColumnSpacing="10">
      <Border Classes="Card" Padding="0"><Grid RowDefinitions="46,*"><Border Padding="14,12" BorderBrush="{DynamicResource DentallaLine}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Пациенты" Classes="H2" /><TextBlock Grid.Column="1" Text="{Binding SearchResults.Count}" Classes="Muted" /></Grid></Border><ListBox Grid.Row="1" Classes="LightSelection" ItemsSource="{Binding SearchResults}" SelectedItem="{Binding SelectedPatient}" SelectionChanged="OnPatientSelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="0" Margin="4,1"><TextBlock Text="{Binding FullName}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding CardNumber, StringFormat='карта № {0}'}" Classes="Muted" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
      <views:PatientCardView Grid.Column="1" />
    </Grid>
  </Grid>
</UserControl>
